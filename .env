# LOCAL CONFIGURATION ONLY — do not upload this file to GitHub.
# Replace the placeholder with your own MongoDB Atlas connection string.
PORT=5000
MONGODB_URI=mongodb+srv://YOUR_DB_USERNAME:YOUR_DB_PASSWORD@YOUR_CLUSTER.mongodb.net/task_management?retryWrites=true&w=majority
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=1d
